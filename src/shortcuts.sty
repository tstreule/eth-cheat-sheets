\NeedsTeXFormat{LaTeX2e}
\RequirePackage{./preamble}
\RequirePackage{xstring}


% =============
% === UTILS ===

% Dotting
\DeclareDocumentCommand{\dotwhenblank}{m}{\ifblank{#1}{\:\cdot\:}{#1}} % Fill with dot when blank input
\makeatletter\newcommand\cdotfill{%
    \leavevmode\cleaders\hb@xt@.44em{\hss$\cdot$\hss}\hfill\kern\z@}\makeatother

% Color hooks >> \gray <content> << OR >> \gray{<content>} <<
\DeclareDocumentCommand{\colorize}{mg}{\IfValueTF{#2}{\begingroup\color{#1}#2\endgroup}{\color{#1}}}
\DeclareDocumentCommand{\gray}  {g}{\colorize{Gray}{#1}}
\DeclareDocumentCommand{\green} {g}{\colorize{Green}{#1}}
\DeclareDocumentCommand{\orange}{g}{\colorize{OrangeRed}{#1}}

% Highlighting >> \highlight*[<color>]{<content>} <<
\colorlet{highlight-color}{Gold!30}
\colorlet{highlight-color-alt}{Silver!30}
\NewDocumentCommand{\highlight}{s O{} m}{%
    \colorlet{bg-color}{\ifblank{#2}{highlight-color\IfBooleanF{#1}{-alt}}{#2}}
    \begingroup\setlength\fboxsep{1pt}
    \relax\ifmmode% if in math mode
        \mathchoice%
        {\colorbox{bg-color}{$\displaystyle     #3\vphantom{|}$}}%
        {\colorbox{bg-color}{$\textstyle        #3\vphantom{|}$}}%
        {\colorbox{bg-color}{$\scriptstyle      #3\vphantom{|}$}}%
        {\colorbox{bg-color}{$\scriptscriptstyle#3\vphantom{|}$}}%
    \else% not in math mode
        \colorbox{bg-color}{#3}%
    \fi\endgroup}

% Highlight environment >> \begin{higlightbox}*[<color>][<length>] <content> \end{highlightbox} <<
\NewDocumentEnvironment{highlightbox}{s O{} O{1} +b}{%
    \colorlet{bg-color}{\ifblank{#2}{highlight-color\IfBooleanF{#1}{-alt}}{#2}}
    \colorbox{bg-color}{%
        \begin{minipage}{#3\linewidth-2\fboxsep}\normalcolor#4\end{minipage}%
    }}{}

% Formula environment >> \begin{formula}*[<pos>]{<name>} <content> \end{formula} <<
\DeclareDocumentEnvironment{formula}{s O{t} G{} +b}{\vskip\abovedisplayskip
    \def\ffont{\IfBooleanTF{#1}{\em}{\bfseries}}
    \def\ftext{\ifblank{#3}{}{\begin{tabular}[#2]{@{}>{\ffont}l@{\enskip}}#3:\end{tabular}}}
    \begin{minipage}[#2]{\widthof\ftext}\ftext\end{minipage}%
    \begin{minipage}[#2]{\linewidth-\widthof\ftext}\ifblank{#3}{\centering}{}#4\end{minipage}
    }{\vskip\belowdisplayskip}

% TODOs >> \todo << OR >> \todo{<content>} <<
\NewDocumentCommand{\todo}{g}{%
    \colorlet{todo-color}{red!80}%
    \begin{minipage}{\linewidth}\sffamily\color{todo-color}
        \smallskip\hrule\smallskip
        \textbf{TODO\IfValueT{#1}{:~}}%
        \IfValueTF{#1}{\begingroup\normalcolor#1\endgroup}{\centering}%
        \smallskip\hrule\smallskip%
    \end{minipage}\par}


% ===============
% === Symbols ===

\newcommand*{\TakeFourierOrnament}[1]{{%
    \fontencoding{U}\fontfamily{futs}\selectfont\char#1}}
\newcommand*{\warning}{\text{\TakeFourierOrnament{66}}}


% ===================
% === Mathematics ===

% --- Sub- and superscript ---

\providecommand*{\ped}[1]{\ensuremath{_\mathrm{#1}}}
\providecommand*{\ap}[1]{\ensuremath{^\mathrm{#1}}}

% --- Primitives ---

\DeclareMathOperator{\const}{const} % Constant
\DeclareMathOperator{\iu}{j\mkern1mu} % Imaginary unit
\DeclareMathOperator{\eu}{e} % Euler
\DeclareMathOperator{\rank}{rank} % Matrix rank
\providecommand\bbar{{\mathchar175\mkern-8mub}}
\providecommand\dbar{{\mkern3mu\mathchar175\mkern-12mud}}
\providecommand\hbar{{\mathchar175\mkern-8muh}}

% Tight math
\DeclareMathSymbol{\shortminus}{\mathbin}{AMSa}{"39}
\newcommand{\shortminustop}{{{\shortminus}\!{\top}}}
\DeclareDocumentCommand{\tothe}{m}{\mathop{\scalebox{0.8}{$\mathrm{E}$}}\StrSubstitute{#1}{-}{\shortminus}}

% Number ranges
\DeclareMathOperator{\N}{\mathbb{N}}
\DeclareMathOperator{\R}{\mathbb{R}}
\DeclareMathOperator{\C}{\mathbb{C}}

% Parentheses
\providecommand\given{} % ensure command exists
\newcommand\SetSymbol[1][]{\nonscript\:#1\vert\allowbreak\nonscript\:\mathopen{}}
\DeclarePairedDelimiterX{\paren}[1]\lparen\rparen{
    \renewcommand\given{\SetSymbol[\delimsize]} % let `\given` behave as `\middle\mid`
    \dotwhenblank{#1}}
\let\brack\undefined
\DeclarePairedDelimiterX{\brack}[1]\lbrack\rbrack{
    \renewcommand\given{\SetSymbol[\delimsize]} % let `\given` behave as `\middle\mid`
    \dotwhenblank{#1}}
\let\brace\undefined
\DeclarePairedDelimiterX{\brace}[1]\lbrace\rbrace{
    \renewcommand\given{\SetSymbol[\delimsize]} % let `\given` behave as `\middle\mid`
    \dotwhenblank{#1}}

% --- Functions (and operators) ---

% Functions with optional delimiters
\DeclareDocumentCommand{\exp}  {sd()}{\mathop{\mathrm{exp}}\IfValueT{#2}{\IfBooleanTF{#1}{\paren*{#2}}{\paren{#2}}}}
\DeclareDocumentCommand{\diag} {sd()}{\mathop{\mathrm{diag}}\IfValueT{#2}{\IfBooleanTF{#1}{\paren*{#2}}{\paren{#2}}}}
\DeclareDocumentCommand{\sign} {sd()}{\mathop{\mathrm{sgn}}\IfValueT{#2}{\IfBooleanTF{#1}{\paren*{#2}}{\paren{#2}}}}

% Functions with mandatory delimiters
\DeclarePairedDelimiterX{\abs  }[1]\lvert\rvert  {\dotwhenblank{#1}}
\DeclarePairedDelimiterX{\norm }[1]\lVert\rVert  {\dotwhenblank{#1}}
\DeclarePairedDelimiterX{\avg  }[1]\langle\rangle{\dotwhenblank{#1}}
\DeclarePairedDelimiterX{\ceil }[1]\lceil\rceil  {\dotwhenblank{#1}}
\DeclarePairedDelimiterX{\floor}[1]\lfloor\rfloor{\dotwhenblank{#1}}

% Probability
\DeclareDocumentCommand{\P}    {sO{}g}{\mathop{\mathbb{P}_{#2}}           \IfValueT{#3}{\IfBooleanTF#1{\paren*{#3}}{\paren{#3}}}}
\DeclareDocumentCommand{\E}    {sO{}g}{\mathop{\mathbb{E}_{#2}}           \IfValueT{#3}{\IfBooleanTF#1{\brack*{#3}}{\brack{#3}}}}
\DeclareDocumentCommand{\V}    {sO{}g}{\mathop{\mathbb{V}_{#2}}           \IfValueT{#3}{\IfBooleanTF#1{\brack*{#3}}{\brack{#3}}}}
\DeclareDocumentCommand{\Var}  {sO{}g}{\mathop{\mathbb{V}_{#2}}           \IfValueT{#3}{\IfBooleanTF#1{\brack*{#3}}{\brack{#3}}}}
\DeclareDocumentCommand{\Cov}  {sO{}g}{\mathop{\mathbb{C}\mathrm{ov}_{#2}}\IfValueT{#3}{\IfBooleanTF#1{\paren*{#3}}{\paren{#3}}}}
\DeclareDocumentCommand{\Gauss}{sO{}g}{\mathop{\mathcal{N}_{#2}}          \IfValueT{#3}{\IfBooleanTF#1{\paren*{#3}}{\paren{#3}}}}

% --- Differential operator and derivative ---

\DeclareMathOperator{\diff}{d \!}
\NewDocumentCommand{\deriv} {O{}mG{}}{\frac%
    {\diff^{#1}\ifblank{#3}{~}{#2}}%
    {\diff\ifblank{#3}{#2}{#3}^{#1}}}
\NewDocumentCommand{\pderiv}{O{}mG{}}{\frac%
    {\partial^{#1}\ifblank{#3}{~}{#2}}%
    {\partial\ifblank{#3}{#2}{#3}^{#1}}}
